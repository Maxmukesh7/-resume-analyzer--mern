# ===================================================
# AI Resume Analyzer - Global Environment Example
# Copy values to server/.env and client/.env respectively
# ===================================================

# -----------------
# Backend Config
# -----------------
PORT=5000
MONGODB_URI=
NODE_ENV=development
MAX_FILE_SIZE=5242880
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=
REFRESH_SECRET=
JWT_EXPIRE=15m
REFRESH_EXPIRE=7d

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini AI API Key (Optional - Rule-based fallback active if omitted)
GEMINI_API_KEY=

# -----------------
# Frontend Config
# -----------------
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=
