# ===================================================
# AI Resume Analyzer - Global Environment Example
# Copy values to server/.env for local backend development
# Or configure directly in Render Dashboard Environment Variables
# ===================================================

# ---------------------------------------------------
# Backend Configuration (Set in Render Dashboard)
# ---------------------------------------------------
NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resume-analyzer?retryWrites=true&w=majority
MAX_FILE_SIZE=5242880

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRE=15m
REFRESH_EXPIRE=7d

# Google Gemini AI API Key (Server-Side Only - Fallback rule engine active if omitted)
GEMINI_API_KEY=

# Optional CORS Origin override (Leave unset or set to your Render URL)
CORS_ORIGIN=

# ---------------------------------------------------
# Frontend Configuration (Optional for single-service)
# ---------------------------------------------------
# In single-service production, frontend defaults to relative '/api' automatically.
# Only set VITE_API_URL if frontend is hosted on a separate external domain.
# VITE_API_URL=/api

