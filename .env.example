# ==============================================================================
# AI Resume Analyzer - Global Environment Variables Template
# ==============================================================================
# Copy required variables to server/.env and client/.env for local development
# Or configure them directly in your Render Dashboard Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Web Service Configuration (Render Dashboard -> Backend Web Service)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/resume_analyzer?retryWrites=true&w=majority
MAX_FILE_SIZE=5242880

# JWT Security
JWT_SECRET=your_super_secret_jwt_access_key_min_32_characters
REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters
JWT_EXPIRE=15m
REFRESH_EXPIRE=7d

# Google Gemini AI Key
GEMINI_API_KEY=

# CORS Origin: Set to your deployed Frontend URL on Render
# Example: https://ai-resume-analyzer-client.onrender.com
# Multiple origins can be comma-separated: https://site1.onrender.com, https://site2.com
CORS_ORIGIN=https://your-frontend-site.onrender.com

# ------------------------------------------------------------------------------
# 2. Frontend Static Site Configuration (Render Dashboard -> Frontend Static Site)
# ------------------------------------------------------------------------------
# NOTE: In Vite, variables starting with VITE_ are injected at BUILD TIME.
# Set VITE_API_URL in your Render Static Site environment variables:
# VITE_API_URL=https://your-backend-service.onrender.com/api
#
# (If deploying as a single full-stack web service where Express serves client/dist,
# leave VITE_API_URL unset and it will automatically default to relative '/api')
VITE_API_URL=https://your-backend-service.onrender.com/api
