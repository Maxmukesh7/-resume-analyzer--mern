# ==============================================================================
# Client Environment Configuration (.env)
# ==============================================================================
#
# Production Deployment on Render (Separated Frontend Static Site):
# Set VITE_API_URL in Render Dashboard Environment Variables to your deployed backend URL:
# VITE_API_URL=https://your-backend-service.onrender.com/api
#
# Single-Service Full-Stack Deployment (Frontend served by Express):
# Leave VITE_API_URL unset or set to relative '/api':
# VITE_API_URL=/api
#
# Local Development:
# VITE_API_URL=http://localhost:5000/api
# ==============================================================================

VITE_API_URL=http://localhost:5000/api
