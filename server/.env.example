# ==============================================================================
# Server Environment Configuration (.env)
# ==============================================================================
# Render automatically sets PORT (typically 10000) and RENDER_EXTERNAL_URL
# ==============================================================================

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/resume_analyzer?retryWrites=true&w=majority
NODE_ENV=production
MAX_FILE_SIZE=5242880

# CORS Allowed Origin (Set in Render Dashboard to your deployed frontend URL)
# Example: https://your-frontend-site.onrender.com or comma-separated list
CORS_ORIGIN=https://your-frontend-site.onrender.com

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_key_min_32_characters
REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters
JWT_EXPIRE=15m
REFRESH_EXPIRE=7d

# Google Gemini AI API Key (Server-side LLM Analysis)
GEMINI_API_KEY=
